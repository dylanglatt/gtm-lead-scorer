__pycache__/
*.pyc
*.egg-info/
.DS_Store
# macOS writes this into any zip it creates; the distributed bundle carried one.
__MACOSX/
.venv*/
venv/
.pytest_cache/

# data/ is generated by make_synthetic_data.py, so it is ignored by default — with one
# exception. The training set itself IS committed: the README claims the model is fit on
# synthetic data, and a reviewer being able to open the file and check that claim is the
# whole point of making it.
data/*
!data/leads_train.csv
